<form class="sign-in-form">
    <div class="form-group">
        <label for="registerEmail">Email</label>
        <input type="email"
               class="form-control"
               id="registerEmail"
               name="email"
               autofocus
               aria-describedby="emailHelp"
               placeholder="enter your email ...">
    </div>
    <div class="form-group">
        <label for="registerPassword">Password</label>
        <input type="password"
               class="form-control"
               id="registerPassword"
               name="password"
               placeholder="enter your password ...">
    </div>
    <button type="button" class="btn btn-primary full-with sign-in-btn">Sign In</button>
</form>