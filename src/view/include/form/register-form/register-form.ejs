<form class="register-form">
    <div class="form-group">
        <label for="registerName">Name</label>
        <input type="text"
               class="form-control"
               id="registerName"
               name="name"
               autofocus
               aria-describedby="nameHelp"
               placeholder="Jane Doe...">
    </div>
    <div class="form-group">
        <label for="registerEmail">Email</label>
        <input type="email"
               class="form-control"
               id="registerEmail"
               name="email"
               aria-describedby="emailHelp"
               placeholder="example@email.com...">
    </div>
    <div class="form-group">
        <label for="registerPassword">Password</label>
        <input type="password"
               class="form-control"
               id="registerPassword"
               name="password"
               placeholder="admin1234...">
    </div>
    <button type="button" class="btn btn-primary full-with register-btn">Create Account</button>
</form>