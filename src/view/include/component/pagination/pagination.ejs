<%
    const current = Number(pagination.current) || 1;
    const total = Number(pagination.total) || 1;
    const prevPage = Number(pagination.prevPage) || null;
    const nextPage = Number(pagination.nextPage) || null;
%>

<% if (total > 1) { %>
    <nav class="pagination-container" aria-label="Page navigation">
        <% if (prevPage) { %>
            <a href="<%= pagePath %>?page=<%= prevPage %>"
               class="pagination-btn pagination-prev"
               aria-label="Previous Page">
                &laquo; Prev
            </a>
        <% } else { %>
            <button class="pagination-btn pagination-prev disabled" disabled>&laquo; Prev</button>
        <% } %>
        <div class="pagination-pages">
            <% for (let i = 1; i <= total; i++) { %>
                <a href="<%= pagePath %>?page=<%= i %>"
                   class="pagination-num <%= i === current ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>
        </div>
        <% if (nextPage) { %>
            <a href="<%= pagePath %>?page=<%= nextPage %>"
               class="pagination-btn pagination-next"
               aria-label="Next Page">
                Next &raquo;
            </a>
        <% } else { %>
            <button class="pagination-btn pagination-next disabled" disabled>Next &raquo;</button>
        <% } %>
    </nav>
<% } %>