<%
    const current = Number(pagination.current) || 1;
    const total = Number(pagination.total) || 1;
    const perPage = Number(pagination.perPage) || 6;
    const prevPage = pagination.prevPage ? Number(pagination.prevPage) : null;
    const nextPage = pagination.nextPage ? Number(pagination.nextPage) : null;

    const maxVisible = 5;
    let startPage = 1;
    let endPage = total;
    let showEllipsis = false;

    if (total > maxVisible) {
        startPage = Math.max(1, current - 2);
        endPage = startPage + maxVisible - 1;

        if (endPage >= total) {
            endPage = total - 1;
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        if (endPage < total - 1) {
            showEllipsis = true;
        }
    }

    const perPageOptions = [5, 10, 20, 50, 100];
%>

<% if (total > 1 || perPageOptions.includes(perPage)) { %>
    <nav class="pagination-container"
         aria-label="Page navigation"
         data-current-page="<%= current %>"
         data-total-pages="<%= total %>"
         data-per-page="<%= perPage %>">
        <div class="pagination-per-page">
            <label for="PerPageSelect" class="pagination-label">Show:</label>
            <select id="PerPageSelect" class="pagination-select">
                <% perPageOptions.forEach(option => { %>
                    <option value="<%= option %>" <%= option === perPage ? 'selected' : '' %>>
                        <%= option %>
                    </option>
                <% }) %>
            </select>
        </div>
        <% if (prevPage) { %>
            <button type="button"
                    class="pagination-btn pagination-prev"
                    data-page="<%= prevPage %>"
                    aria-label="Previous Page">
                &laquo; Prev
            </button>
        <% } else { %>
            <button type="button"
                    class="pagination-btn pagination-prev disabled"
                    disabled>&laquo; Prev</button>
        <% } %>
        <div class="pagination-pages">
            <% for (let i = startPage; i <= endPage; i++) { %>
                <button type="button"
                        class="pagination-num <%= i === current ? 'active' : '' %>"
                        data-page="<%= i %>">
                    <%= i %>
                </button>
            <% } %>
            <% if (showEllipsis) { %>
                <span class="pagination-ellipsis">&hellip;</span>
                <button type="button"
                        class="pagination-num <%= total === current ? 'active' : '' %>"
                        data-page="<%= total %>">
                    <%= total %>
                </button>
            <% } %>
        </div>
        <% if (nextPage) { %>
            <button type="button"
                    class="pagination-btn pagination-next"
                    data-page="<%= nextPage %>"
                    aria-label="Next Page">
                Next &raquo;
            </button>
        <% } else { %>
            <button type="button"
                    class="pagination-btn pagination-next disabled"
                    disabled>
                Next &raquo;
            </button>
        <% } %>
        <form class="pagination-jump">
            <label for="GoToPageInput" hidden>Go to page</label>
            <input  id="GoToPageInput"
                    type="number"
                    name="jumpPage"
                    class="pagination-jump-input"
                    min="1"
                    max="<%= total %>"
                    placeholder="Page"
                    required/>
            <button type="submit" class="pagination-jump-btn">Go</button>
        </form>
    </nav>
<% } %>