<%- include("../../layout/head.ejs") %>
    <link rel="stylesheet" href="/view/page/user-page/user.css" />
</head>
<body class="page-wrapper ">
    <%- include("../../include/component/navigation/navigation.ejs") %>
    <main id="UserPage" class="container">
        <%- include("../../include/component/page-info-action/page-info-action.ejs") %>
        <div class="user-page-container">
            <div class="user-profile-wrapper">
                <div class="user-profile-card">
                    <div class="user-avatar-block">
                        <span><%= user.name[0] %></span>
                    </div>
                    <div class="user-info-block">
                        <span class="user-name"><%= user.name %></span>
                        <span class="user-email"><%= user.email %></span>
                        <span class="user-role-badge"><%= user.role || 'Admin' %></span>
                    </div>
                </div>
                <form class="user-profile-form form-container" action="api/user/update" method="POST">
                    <input type="hidden" name="id" value="<%= user.id %>">
                    <div class="form-group">
                        <label for="FullName">Full name</label>
                        <div class="input-with-icon">
                            <input type="text"
                                   id="FullName"
                                   name="name"
                                   class="form-control"
                                   value="<%= user.name %>"
                                   placeholder="Enter full name" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="EmailAddress">
                            Email address <span class="label-note">(cannot be changed)</span>
                        </label>
                        <input type="email"
                               id="EmailAddress"
                               name="email"
                               class="form-control disabled-input"
                               value="<%= user.email %>"
                               disabled />
                    </div>
                    <!--<div class="form-section-title">
                        <span>Address</span>
                    </div>-->
                    <div class="form-group user-address-block">
                        <label for="OrderAddress">Address</label>
                        <textarea name="orderAddress"
                                  id="OrderAddress"
                                  rows="5"
                                  placeholder="Enter user address..."><%= user.address %></textarea>
                    </div>
                    <div class="form-section-title">
                        <span>Change password</span>
                    </div>
                    <div class="form-group">
                        <label for="NewPassword">New password</label>
                        <div class="input-with-icon">
                            <input type="password"
                                   id="NewPassword"
                                   name="newPassword"
                                   class="form-control"
                                   placeholder="Leave blank to keep current" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="ConfirmPassword">Confirm new password</label>
                        <div class="input-with-icon">
                            <input type="password"
                                   id="ConfirmPassword"
                                   name="confirmPassword"
                                   class="form-control"
                                   placeholder="Repeat new password" />
                        </div>
                    </div>
                    <div class="form-action-block">
                        <button type="button" class="btn btn-primary full-with save-btn">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <script type="module" src="/view/page/user-page/user.js"></script>
<%- include("../../layout/bottom.ejs") %>

