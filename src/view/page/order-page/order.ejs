<%- include("../../layout/head.ejs") %>
    <link rel="stylesheet" href="/view/page/order-page/order.css" />
</head>
<body class="page-wrapper" data-csrf="<%= csrfToken %>">
    <%- include("../../include/component/navigation/navigation.ejs") %>
    <main id="OrderPage" class="container" data-order-id="<%= order?.id %>">
        <%- include("../../include/component/page-info-action/page-info-action.ejs") %>
        <div class="order-page-container">
            <% if(order && cart && cart.products && cart.products.length > 0) { %>
                <div class="order-confirmation-block">
                    <div class="order-card-container form-container">
                        <div class="order-card-header">
                            <div class="order-info-block">
                                <span class="order-id">Order #<%= order.id %></span>
                                <span class="order-date"><%= new Date(order.registerDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                            </div>
                            <div class="order-action-block">
                                <span class="order-total-price">$<%= cart.totalPrice.toFixed(2) %></span>
                                <span class="order-status-badge">Confirmed</span>
                                <button class="btn btn-danger btn-small cancel-order-btn">Cancel order</button>
                            </div>
                        </div>
                        <div class="order-card-body">
                            <div class="order-detail-column">
                                <label class="column-title">CUSTOMER</label>
                                <div class="customer-info-container">
                                    <div class="customer-avatar">
                                        <span><%= user.name[0] %></span>
                                    </div>
                                    <div class="customer-details">
                                        <span class="customer-name"><%= user.name %></span>
                                        <span class="customer-email"><%= user.email %></span>
                                    </div>
                                </div>
                            </div>
                            <div class="order-detail-column">
                                <label class="column-title">DELIVERY ADDRESS</label>
                                <span class="delivery-address-text"><%= order.address %></span>
                            </div>
                            <div class="order-detail-column items-column">
                                <label class="column-title">ITEMS ORDERED</label>
                                <div class="ordered-items-list">
                                    <% cart.products.forEach(product => { %>
                                        <div class="ordered-item-card">
                                            <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="item-image" />
                                            <div class="item-details">
                                                <span class="item-title"><%= product.title %></span>
                                                <span class="item-meta"><%= product.quantity || 1 %> &times; $<%= product.price %></span>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <%- include("../../include/component/no-data-placeholder/no-data-placeholder.ejs", {
                icon: "/media/icons/product.svg",
                title: "No orders yet",
                description: "Place your first order from the cart.",
                btnText: "Browse products",
                link: "/product-list"
                })%>
            <% } %>
        </div>
    </main>
    <script type="module" src="/view/page/order-page/order.js"></script>
<%- include("../../layout/bottom.ejs") %>

